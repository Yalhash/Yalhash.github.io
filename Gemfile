source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses.
gem "github-pages", group: :jekyll_plugins

# Needed to run `jekyll serve` on Ruby 3+.
gem "webrick"

# No longer bundled with Ruby 3.4+, but Jekyll 3.x still requires them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

# Windows: timezone data and efficient file watching.
platforms :windows do
  gem "tzinfo-data"
  gem "wdm", ">= 0.1.0"
end
